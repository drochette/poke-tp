{% extends 'base.html.twig' %}

{% block title %}Fiche Pokemon {{ pokemon.label }}{% endblock %}

{% block body %}
    <h2>Pokemon {{ pokemon.label }}</h2>

    <div class="row">
        <div class="col-md-5">
            <b>Experience de base</b> {{ pokemonInfo.baseExperience }}
        </div>
        <div class="col-md-5">
            <b>Capacités</b>
            <ul>
                {% for capacity in pokemonInfo.abilities %}
                    <li>{{ capacity }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div>
        <a href="{{ url('app_add_pokemon_to_pokedex', {id: pokemon.id}) }}">Ajouter dans mon pokedex !</a>
    </div>
{% endblock %}
